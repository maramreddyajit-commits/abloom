{
  "expo": {
    "name": "Abloom",
    "slug": "abloom",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/stage4.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#FFF8F0",
      "resizeMode": "contain",
      "image": "./assets/images/stage4.png"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.abloom.app",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/stage4.png",
        "backgroundColor": "#FFF8F0"
      },
      "package": "com.abloom.app"
    },
    "extra": {
      "eas": {
        "projectId": ""
      }
    },
    "web": {
      "favicon": "./assets/images/stage4.png",
      "bundler": "metro"
    }
  }
}
