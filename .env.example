# AI companion: the URL of your deployed Cloudflare Worker (server/ai-proxy).
# Leave empty and the app works fully, with the companion showing a "coming soon" note.
EXPO_PUBLIC_AI_PROXY_URL=https://abloom-ai-proxy.<your-subdomain>.workers.dev
# Optional: must match the worker's APP_TOKEN secret.
EXPO_PUBLIC_AI_APP_TOKEN=

# Optional privacy-safe analytics (PostHog). Off unless set AND the user opts in.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
